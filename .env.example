# ForgeArtisan AI Environment Configuration Example
# Copy this file to .env and configure your keys

# Meta Model API credentials (via Meta / partner endpoints)
MODEL_API_KEY=your_meta_model_api_key_here
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Optional Model Names (Defaults to muse-spark-1.3)
MODEL_NAME=muse-spark-1.3
VISION_MODEL_NAME=muse-spark-1.3

# Game Engine Bridge (Default local Unity editor port)
UNITY_BRIDGE_URL=http://127.0.0.1:8080
